{
  "permissions": {
    "allow": [
      "Bash(node -e ' *)",
      "Bash(ssh -T git@github-a)",
      "Bash(ssh -T git@github-b)",
      "Bash(ssh -T git@github.com)",
      "Bash(ssh -vT git@github-b)",
      "Bash(ssh -vT git@github-a)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -m code_review_graph update --skip-flows",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python -m code_review_graph status",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
